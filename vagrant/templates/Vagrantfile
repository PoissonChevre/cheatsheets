# Vagrantfile — simple lab with 2 Ubuntu VMs (VirtualBox)
#
#   vagrant up            create and start the VMs
#   vagrant ssh node1     connect to node1
#   vagrant halt          stop the VMs
#   vagrant destroy -f    delete the VMs

Vagrant.configure("2") do |config|

  # Image for all VMs
  config.vm.box = "bento/ubuntu-24.04"

  # Runs on every VM, only at the first "vagrant up"
  config.vm.provision "shell", inline: <<-SHELL
    apt-get update
    apt-get install -y curl vim git
    echo "192.168.56.11 node1" >> /etc/hosts
    echo "192.168.56.12 node2" >> /etc/hosts
  SHELL

  # VM 1
  config.vm.define "node1" do |node|
    node.vm.hostname = "node1"
    node.vm.network "private_network", ip: "192.168.56.11"
    node.vm.network "forwarded_port", guest: 80, host: 8080
    node.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
    end
  end

  # VM 2
  config.vm.define "node2" do |node|
    node.vm.hostname = "node2"
    node.vm.network "private_network", ip: "192.168.56.12"
    node.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
    end
  end

end
